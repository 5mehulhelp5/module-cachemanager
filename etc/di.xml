<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Magento\Framework\View\Element\UiComponent\DataProvider\CollectionFactory">
        <arguments>
            <argument name="collections" xsi:type="array">
                <item name="panth_cachemanager_warmup_listing_data_source" xsi:type="string">Panth\CacheManager\Model\ResourceModel\WarmupLog\Grid\Collection</item>
            </argument>
        </arguments>
    </type>
    <type name="Magento\Framework\Console\CommandList">
        <arguments>
            <argument name="commands" xsi:type="array">
                <item name="panth_cachemanager_warmup" xsi:type="object">Panth\CacheManager\Console\Command\WarmupCommand</item>
            </argument>
        </arguments>
    </type>

    <virtualType name="Panth\CacheManager\Ui\WarmupLogGridFulltextFilter" type="Panth\CacheManager\Ui\Component\Listing\LikeFulltextFilter">
        <arguments>
            <argument name="columns" xsi:type="array">
                <item name="url" xsi:type="string">main_table.url</item>
                <item name="page_type" xsi:type="string">main_table.page_type</item>
                <item name="status" xsi:type="string">main_table.status</item>
            </argument>
        </arguments>
    </virtualType>
    <virtualType name="Panth\CacheManager\Ui\WarmupLogGridFilterPool" type="Magento\Framework\View\Element\UiComponent\DataProvider\FilterPool">
        <arguments>
            <argument name="appliers" xsi:type="array">
                <item name="regular" xsi:type="object">Magento\Framework\View\Element\UiComponent\DataProvider\RegularFilter</item>
                <item name="fulltext" xsi:type="object">Panth\CacheManager\Ui\WarmupLogGridFulltextFilter</item>
            </argument>
        </arguments>
    </virtualType>
    <virtualType name="Panth\CacheManager\Ui\WarmupLogGridReporting" type="Magento\Framework\View\Element\UiComponent\DataProvider\Reporting">
        <arguments>
            <argument name="filterPool" xsi:type="object">Panth\CacheManager\Ui\WarmupLogGridFilterPool</argument>
        </arguments>
    </virtualType>
    <virtualType name="Panth\CacheManager\Ui\WarmupLogGridDataProvider" type="Magento\Framework\View\Element\UiComponent\DataProvider\DataProvider">
        <arguments>
            <argument name="reporting" xsi:type="object">Panth\CacheManager\Ui\WarmupLogGridReporting</argument>
        </arguments>
    </virtualType>
</config>
